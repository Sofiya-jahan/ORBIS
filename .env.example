# IPRAP Environment Configuration Template
# Copy this file to .env and fill in your values

# Firebase Authentication & App Services
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Neon PostgreSQL Database & Message Storage
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
VITE_NEON_DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Supabase Storage (Images & Media Assets)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# NVIDIA Nemotron AI Assistant Configuration
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VITE_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

